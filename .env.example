# ============================================================
# WeFunk Dashboard - example configuration
# ============================================================
#
# Copy this file to:
#
#   .env
#
# and customize values for your system.
#
# Never commit your real .env file.
# ============================================================


# ------------------------------------------------------------
# Project / runtime paths
# ------------------------------------------------------------

# Usually leave this unset.
# Defaults to the directory containing the project.
#
# WEFUNK_PROJECT_ROOT=/path/to/wefunk-dashboard


# Runtime data root.
#
# Contains databases, exports, JSON metadata, artwork, playlists,
# state files, and timing-cache data.
#
# Default:
#   ~/.local/share/wefunk
#
# WEFUNK_DATA_DIR=/path/to/wefunk-data


# Main music library.
#
# Default:
#   ~/Music
#
# WEFUNK_MUSIC_DIR=/path/to/music


# Directory containing downloaded WEFUNK episode audio.
#
# Default:
#   $WEFUNK_MUSIC_DIR/wefunkradio mixes
#
# WEFUNK_EPISODE_DIR=/path/to/wefunk-episodes


# Generated dashboard site.
#
# Default:
#   <project>/site
#
# WEFUNK_SITE_DIR=/path/to/generated-site


# Optional explicit exports directory.
#
# Default:
#   $WEFUNK_DATA_DIR/exports
#
# WEFUNK_EXPORT_DIR=/path/to/exports


# Optional explicit SQLite database.
#
# Default:
#   $WEFUNK_DATA_DIR/db/wefunk.db
#
# WEFUNK_DB_FILE=/path/to/wefunk.db


# ------------------------------------------------------------
# Dashboard server
# ------------------------------------------------------------

# Local HTTP port.
#
# Default:
#   8099
#
WEFUNK_PORT=8099


# Optional externally accessible dashboard URL.
#
# Example:
#   https://wefunk.example.com
#
# Used when generating absolute links and by helper commands.
#
# WEFUNK_PUBLIC_URL=https://wefunk.example.com


# ------------------------------------------------------------
# Navidrome
# ------------------------------------------------------------

# Navidrome base URL.
#
# Example:
#   http://localhost:4533
#
ND_URL=http://localhost:4533


# Navidrome username.
#
ND_USER=


# Navidrome password.
#
# Keep your real password only in .env or another private
# environment file. Never commit it.
#
ND_PASS=


# ------------------------------------------------------------
# Optional external tools
# ------------------------------------------------------------

# Path to the WEFUNK scraper script if using automatic metadata
# refresh functionality.
#
# WEFUNK_SCRAPER_SCRIPT=/path/to/Wefunkpl.py


# Path to an external WEFUNK downloader project if using the
# download helper.
#
# WEFUNK_DOWNLOADER_DIR=/path/to/wefunkdownloader


# Override the Python virtual environment.
#
# Default:
#   <project>/.venv
#
# WEFUNK_VENV=/path/to/.venv


# Override Python executable directly.
#
# Default:
#   $WEFUNK_VENV/bin/python
#
# WEFUNK_PYTHON=/path/to/python


# Override the WEFUNK engine script.
#
# Default:
#   <project>/wefunk-engine/wefunk_engine.py
#
# WEFUNK_ENGINE_SCRIPT=/path/to/wefunk_engine.py

# Override the dashboard-build command used by wefunk-scan.
#
# Normally leave this unset.
#
# Default:
#   <project>/bin/wefunk-dashboard
#
# WEFUNK_DASHBOARD_SCRIPT=/path/to/wefunk-dashboard

# Override the library matcher.
#
# Default:
#   <project>/engine/match_library_tags_v2.py
#
# WEFUNK_MATCHER_SCRIPT=/path/to/match_library_tags_v2.py


# ------------------------------------------------------------
# Advanced build paths
# ------------------------------------------------------------

# Normally these should remain unset.
#
# WEFUNK_BUILD_STEPS=<project>/wefunk-dashboard/build_steps.txt
# WEFUNK_SITE_NEXT_DIR=<project>/site-next
# WEFUNK_SITE_BACKUP_DIR=<project>/site-backup-last-good
# WEFUNK_LOG_DIR=<project>/logs


# ------------------------------------------------------------
# macOS optional now-playing LaunchAgent
# ------------------------------------------------------------

# WEFUNK_NOWPLAYING_LABEL=org.wefunk.dashboard.nowplaying


# ------------------------------------------------------------
# Advanced artist image options
# ------------------------------------------------------------

# Optional limit on the number of artist images processed during
# a MusicBrainz image pass.
#
# Leave unset for normal operation.
#
# WEFUNK_ARTIST_IMAGE_LIMIT=


# Enable the secondary artist-image lookup pass.
#
# Leave unset for normal operation.
#
# WEFUNK_ARTIST_IMAGE_PASS2=


# Retry artists that previously produced no image match.
#
# Leave unset for normal operation.
#
# WEFUNK_ARTIST_IMAGE_RETRY_NO_MATCH=
