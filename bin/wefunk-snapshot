#!/bin/zsh

set -u
set -o pipefail

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
PROJECT="${WEFUNK_PROJECT_ROOT:-$(cd "$SCRIPT_DIR/.." && pwd)}"

DATA_ROOT="${WEFUNK_DATA_DIR:-$HOME/.local/share/wefunk}"
DB="${WEFUNK_DB_FILE:-$DATA_ROOT/db/wefunk.db}"
STATE_DIR="${WEFUNK_STATE_DIR:-$DATA_ROOT/state}"
RECOVERY_ROOT="${WEFUNK_RECOVERY_DIR:-$DATA_ROOT/recovery}"

WEFUNK_MANAGER="${WEFUNK_MANAGER:-}"
DASHBOARD_LABEL="${WEFUNK_DASHBOARD_LABEL:-org.wefunk.dashboard}"
WEFUNK_PLIST="${WEFUNK_DASHBOARD_PLIST:-$HOME/Library/LaunchAgents/$DASHBOARD_LABEL.plist}"

TIMESTAMP="$(date '+%Y%m%d-%H%M%S')"
SNAPSHOT_ID="$TIMESTAMP"
FINAL_DIR="$RECOVERY_ROOT/$SNAPSHOT_ID"
WORK_DIR="$RECOVERY_ROOT/.creating-$SNAPSHOT_ID-$$"

LABEL="${1:-Manual recovery snapshot}"

green() {
    printf "\033[32m%s\033[0m\n" "$1"
}

yellow() {
    printf "\033[33m%s\033[0m\n" "$1"
}

red() {
    printf "\033[31m%s\033[0m\n" "$1"
}

heading() {
    echo
    printf "\033[1m%s\033[0m\n" "$1"
    echo "--------------------------------------------------"
}

fail() {
    red "$1"
    echo
    echo "Incomplete snapshot preserved at:"
    echo "  $WORK_DIR"
    exit 1
}

usage() {
    cat <<'EOF'

WEFUNK Recovery Snapshot

Usage:
  ./bin/wefunk-snapshot
  ./bin/wefunk-snapshot "Description"

Examples:
  ./bin/wefunk-snapshot
  ./bin/wefunk-snapshot "Before dashboard upgrade"

The snapshot includes:
  - Project source and configuration
  - SQLite-consistent WEFUNK database
  - WEFUNK operational state
  - Optional configured system files

Generated and disposable files are excluded.

EOF
}

if [[ "${1:-}" == "--help" || "${1:-}" == "-h" ]]; then
    usage
    exit 0
fi

heading "Creating WEFUNK Recovery Snapshot"

echo "Snapshot ID: $SNAPSHOT_ID"
echo "Description: $LABEL"
echo "Destination: $FINAL_DIR"
echo

if [[ ! -d "$PROJECT" ]]; then
    red "Project directory not found:"
    echo "  $PROJECT"
    exit 1
fi

if [[ ! -f "$DB" ]]; then
    red "WEFUNK database not found:"
    echo "  $DB"
    exit 1
fi

if ! command -v sqlite3 >/dev/null 2>&1; then
    red "sqlite3 is not available."
    exit 1
fi

if ! command -v rsync >/dev/null 2>&1; then
    red "rsync is not available."
    exit 1
fi

mkdir -p "$RECOVERY_ROOT" || exit 1

if [[ -e "$FINAL_DIR" ]]; then
    red "Snapshot already exists:"
    echo "  $FINAL_DIR"
    exit 1
fi

mkdir -p \
    "$WORK_DIR/code" \
    "$WORK_DIR/database" \
    "$WORK_DIR/state" \
    "$WORK_DIR/system" || fail "Could not create snapshot directories."

heading "Checking Live Database"

LIVE_DB_CHECK="$(
    sqlite3 "$DB" 'PRAGMA quick_check;' 2>&1
)"
LIVE_DB_STATUS=$?

if [[ $LIVE_DB_STATUS -ne 0 || "$LIVE_DB_CHECK" != "ok" ]]; then
    red "Live database failed SQLite quick_check."
    echo "$LIVE_DB_CHECK"
    echo
    yellow "No snapshot was finalized."
    exit 1
fi

green "Live database quick_check: ok"

heading "Snapshotting Project Source"

rsync -a \
    --exclude '.git/' \
    --exclude '.venv/' \
    --exclude 'backup/' \
    --exclude 'backups/' \
    --exclude 'site/' \
    --exclude 'site-next/' \
    --exclude 'site-backup-last-good/' \
    --exclude 'output-v2/' \
    --exclude 'logs/' \
    --exclude '__pycache__/' \
    --exclude '*.pyc' \
    --exclude '.DS_Store' \
    "$PROJECT/" \
    "$WORK_DIR/code/" \
    || fail "Project snapshot failed."

green "Project source captured"

heading "Snapshotting Database"

sqlite3 "$DB" ".backup '$WORK_DIR/database/wefunk.db'" \
    || fail "SQLite backup failed."

SNAPSHOT_DB_CHECK="$(
    sqlite3 "$WORK_DIR/database/wefunk.db" \
        'PRAGMA quick_check;' 2>&1
)"
SNAPSHOT_DB_STATUS=$?

if [[ $SNAPSHOT_DB_STATUS -ne 0 || "$SNAPSHOT_DB_CHECK" != "ok" ]]; then
    fail "Snapshot database failed SQLite quick_check."
fi

green "Database captured and verified"

heading "Snapshotting WEFUNK State"

if [[ -d "$STATE_DIR" ]]; then
    rsync -a \
        "$STATE_DIR/" \
        "$WORK_DIR/state/" \
        || fail "State snapshot failed."

    green "WEFUNK state captured"
else
    yellow "State directory does not exist; continuing."
fi

heading "Snapshotting System Files"

if [[ -f "$WEFUNK_MANAGER" ]]; then
    cp -p \
        "$WEFUNK_MANAGER" \
        "$WORK_DIR/system/wefunk-manager" \
        || fail "Could not copy WEFUNK manager."

    green "WEFUNK manager captured"
else
    yellow "WEFUNK manager was not found."
fi

if [[ -f "$WEFUNK_PLIST" ]]; then
    cp -p \
        "$WEFUNK_PLIST" \
        "$WORK_DIR/system/dashboard.plist" \
        || fail "Could not copy LaunchAgent."

    green "Dashboard LaunchAgent captured"
else
    yellow "Dashboard LaunchAgent was not found."
fi

heading "Writing Snapshot Manifest"

GIT_BRANCH="$(
    git -C "$PROJECT" branch --show-current 2>/dev/null \
        || echo "unknown"
)"

GIT_COMMIT="$(
    git -C "$PROJECT" rev-parse HEAD 2>/dev/null \
        || echo "unknown"
)"

GIT_SHORT="$(
    git -C "$PROJECT" rev-parse --short HEAD 2>/dev/null \
        || echo "unknown"
)"

GIT_SUBJECT="$(
    git -C "$PROJECT" log -1 --format='%s' 2>/dev/null \
        || echo "unknown"
)"

if [[ -n "$(git -C "$PROJECT" status --porcelain 2>/dev/null)" ]]; then
    GIT_DIRTY="yes"
else
    GIT_DIRTY="no"
fi

DB_BYTES="$(stat -f '%z' "$DB" 2>/dev/null || echo "unknown")"

cat > "$WORK_DIR/manifest.txt" <<MANIFEST
WEFUNK Recovery Snapshot
========================

Snapshot ID:        $SNAPSHOT_ID
Created:            $(date '+%Y-%m-%d %H:%M:%S %Z')
Description:        $LABEL

Project:            $PROJECT
Database:           $DB
State directory:    $STATE_DIR

Git branch:         $GIT_BRANCH
Git commit:         $GIT_COMMIT
Git short commit:   $GIT_SHORT
Git subject:        $GIT_SUBJECT
Working tree dirty: $GIT_DIRTY

Database bytes:     $DB_BYTES
Live DB check:      $LIVE_DB_CHECK
Snapshot DB check:  $SNAPSHOT_DB_CHECK

Contents
--------
code/       Project source and configuration
database/   SQLite-consistent copy of wefunk.db
state/      WEFUNK operational state files
system/     WEFUNK manager and dashboard LaunchAgent

Excluded Generated/Disposable Data
----------------------------------
.git/
.venv/
backup/
backups/
site/
site-next/
site-backup-last-good/
output-v2/
logs/
__pycache__/
*.pyc
MANIFEST

(
    cd "$WORK_DIR/database" || exit 1

    shasum -a 256 wefunk.db \
        > wefunk.db.sha256
) || fail "Could not create database checksum."

green "Manifest and database checksum created"

heading "Finalizing Snapshot"

mv "$WORK_DIR" "$FINAL_DIR" \
    || fail "Could not finalize snapshot."

green "Recovery snapshot created successfully"

echo
echo "Snapshot:"
echo "  $FINAL_DIR"

echo
echo "Contents:"
du -sh \
    "$FINAL_DIR/code" \
    "$FINAL_DIR/database" \
    "$FINAL_DIR/state" \
    "$FINAL_DIR/system" \
    2>/dev/null

echo
echo "Total:"
du -sh "$FINAL_DIR"

echo
echo "Database:"
sqlite3 "$FINAL_DIR/database/wefunk.db" \
    'PRAGMA quick_check;'
