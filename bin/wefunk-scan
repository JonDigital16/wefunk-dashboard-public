#!/bin/zsh
set -e

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
DASHBOARD_ROOT="${WEFUNK_PROJECT_ROOT:-$(cd "$SCRIPT_DIR/.." && pwd)}"

# Load project-local configuration if present.
# Existing exported environment variables take precedence.
if [ -f "$DASHBOARD_ROOT/.env" ]; then
  while IFS= read -r line || [ -n "$line" ]; do
    [[ -z "$line" ]] && continue
    [[ "$line" == \#* ]] && continue

    key="${line%%=*}"
    value="${line#*=}"

    [[ "$key" == "$line" ]] && continue

    if [[ -z "${(P)key+x}" ]]; then
      export "$key=$value"
    fi
  done < "$DASHBOARD_ROOT/.env"
fi

DASHBOARD_APP="$DASHBOARD_ROOT/wefunk-dashboard"
VENV="${WEFUNK_VENV:-$DASHBOARD_ROOT/.venv}"
PYTHON="${WEFUNK_PYTHON:-$VENV/bin/python}"
ENGINE_SCRIPT="${WEFUNK_ENGINE_SCRIPT:-$DASHBOARD_ROOT/wefunk-engine/wefunk_engine.py}"
DASHBOARD_SCRIPT="${WEFUNK_DASHBOARD_SCRIPT:-$DASHBOARD_ROOT/bin/wefunk-dashboard}"

echo "🔍 WEFUNK full scan: engine + optional Navidrome sync + safe rebuild"

echo
echo "1/3 Running WEFUNK engine..."
"$PYTHON" -u "$ENGINE_SCRIPT"

echo
echo "2/3 Optional Navidrome enrichment..."

if [ -n "${ND_URL:-}" ] && [ -n "${ND_USER:-}" ] && [ -n "${ND_PASS:-}" ]; then

  echo "✅ Navidrome configuration detected."
  echo "   Syncing play counts..."

  "$PYTHON" "$DASHBOARD_APP/export_navidrome_play_counts.py"

  echo
  echo "   Downloading new artist images..."

  if "$PYTHON" "$DASHBOARD_APP/download_artist_images.py"; then
    echo "✅ Artist image sync complete."
  else
    echo "⚠️ Artist image sync failed; continuing."
  fi

else

  echo "ℹ️ Navidrome is not configured."
  echo "   Skipping play-count and Navidrome artist-image enrichment."
  echo "   Set ND_URL, ND_USER, and ND_PASS in .env to enable it."

fi

echo
echo "3/3 Rebuilding dashboard safely..."
"$DASHBOARD_SCRIPT"

echo
echo "✅ WEFUNK full scan complete."
