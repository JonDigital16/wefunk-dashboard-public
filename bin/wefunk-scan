#!/bin/zsh
set -e

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
DASHBOARD_ROOT="${WEFUNK_PROJECT_ROOT:-$(cd "$SCRIPT_DIR/.." && pwd)}"

# Load project-local configuration if present.
# Existing exported environment variables take precedence.
if [ -f "$DASHBOARD_ROOT/.env" ]; then
  while IFS= read -r line || [ -n "$line" ]; do
    [[ -z "$line" ]] && continue
    [[ "$line" == \#* ]] && continue

    key="${line%%=*}"
    value="${line#*=}"

    [[ "$key" == "$line" ]] && continue

    if [[ -z "${(P)key+x}" ]]; then
      export "$key=$value"
    fi
  done < "$DASHBOARD_ROOT/.env"
fi

DASHBOARD_APP="$DASHBOARD_ROOT/wefunk-dashboard"
VENV="${WEFUNK_VENV:-$DASHBOARD_ROOT/.venv}"
PYTHON="${WEFUNK_PYTHON:-$VENV/bin/python}"
ENGINE_SCRIPT="${WEFUNK_ENGINE_SCRIPT:-$DASHBOARD_ROOT/wefunk-engine/wefunk_engine.py}"

if [ -f "$HOME/.wefunk-env" ]; then
  source "$HOME/.wefunk-env"
fi

if [ -f "$HOME/.config/wefunk/navidrome.env" ]; then
  source "$HOME/.config/wefunk/navidrome.env"
fi

echo "🔍 WEFUNK full scan: engine + Navidrome sync + artist images + safe rebuild"

echo
echo "1/4 Running WEFUNK engine..."
"$PYTHON" -u "$ENGINE_SCRIPT"

echo
echo "2/4 Syncing Navidrome play counts..."

if [ -z "$ND_URL" ]; then
  read "ND_URL?Navidrome URL: "
  export ND_URL
fi

if [ -z "$ND_USER" ]; then
  read "ND_USER?Navidrome username: "
  export ND_USER
fi

if [ -z "$ND_PASS" ]; then
  read -s "ND_PASS?Navidrome password: "
  echo
  export ND_PASS
fi

"$PYTHON" "$DASHBOARD_APP/export_navidrome_play_counts.py"

echo
echo "3/4 Downloading new artist images..."

if "$PYTHON" "$DASHBOARD_APP/download_artist_images.py"; then
  echo "✅ Artist image sync complete."
else
  echo "⚠️ Artist image sync failed; continuing with dashboard rebuild."
fi

echo
echo "4/4 Rebuilding dashboard safely..."
"$DASHBOARD_ROOT/bin/wefunk-dashboard"

echo
echo "✅ WEFUNK full scan complete."
