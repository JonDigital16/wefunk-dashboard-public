#!/bin/zsh

set -u
set -o pipefail

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
PROJECT="${WEFUNK_PROJECT_ROOT:-$(cd "$SCRIPT_DIR/.." && pwd)}"

DATA_ROOT="${WEFUNK_DATA_DIR:-$HOME/.local/share/wefunk}"
DB="${WEFUNK_DB_FILE:-$DATA_ROOT/db/wefunk.db}"
STATE_DIR="${WEFUNK_STATE_DIR:-$DATA_ROOT/state}"
RECOVERY_ROOT="${WEFUNK_RECOVERY_DIR:-$DATA_ROOT/recovery}"

SNAPSHOT_SCRIPT="$PROJECT/bin/wefunk-snapshot"

PORT="${WEFUNK_PORT:-8099}"
LOCAL_URL="http://127.0.0.1:$PORT/"

DOMAIN="gui/$(id -u)"

DASHBOARD_LABEL="${WEFUNK_DASHBOARD_LABEL:-org.wefunk.dashboard}"
DASHBOARD_PLIST="${WEFUNK_DASHBOARD_PLIST:-$HOME/Library/LaunchAgents/$DASHBOARD_LABEL.plist}"

NOW_PLAYING_LABEL="${WEFUNK_NOWPLAYING_LABEL:-org.wefunk.dashboard.nowplaying}"
NOW_PLAYING_PLIST="${WEFUNK_NOWPLAYING_PLIST:-$HOME/Library/LaunchAgents/$NOW_PLAYING_LABEL.plist}"

DASHBOARD_WAS_LOADED=0
NOW_PLAYING_WAS_LOADED=0
DASHBOARD_WAS_PAUSED=0
NOW_PLAYING_WAS_PAUSED=0
SERVICES_PAUSED=0

green() {
    printf "\033[32m%s\033[0m\n" "$1"
}

yellow() {
    printf "\033[33m%s\033[0m\n" "$1"
}

red() {
    printf "\033[31m%s\033[0m\n" "$1"
}

heading() {
    echo
    printf "\033[1m%s\033[0m\n" "$1"
    echo "--------------------------------------------------"
}

usage() {
    cat <<'EOF'

WEFUNK Full Recovery Rollback

Usage:
  ./bin/wefunk-rollback <snapshot-id>

Dry run:
  ./bin/wefunk-rollback --dry-run <snapshot-id>

Example:
  ./bin/wefunk-rollback 20260901-075913

Safety:
  - --dry-run performs validation and planning only.
  - Target snapshot is verified before rollback.
  - One fresh pre-rollback recovery snapshot is created automatically.
  - Configured macOS LaunchAgents are paused when available.
  - Writable SQLite handles block rollback.
  - Current live database is preserved before replacement.
  - Snapshot database integrity is verified before and after restore.
  - Database WAL/SHM files are preserved rather than deleted.
  - Code, database, and state are restored together.
  - Managed services are restored only after rollback completes successfully.
  - Failures after mutation begins leave services paused for safety.
  - Files added after the snapshot are not deleted.
  - Recovery-toolkit scripts are preserved.

EOF
}

has_launchctl() {
    command -v launchctl >/dev/null 2>&1
}

is_loaded() {
    local label="$1"

    has_launchctl || return 1
    [[ -n "$label" ]] || return 1

    launchctl print "$DOMAIN/$label" >/dev/null 2>&1
}

can_manage_service() {
    local label="$1"
    local plist="$2"

    has_launchctl || return 1
    [[ -n "$label" ]] || return 1
    [[ -f "$plist" ]] || return 1

    return 0
}

pause_services() {
    heading "Pausing WEFUNK Services"

    if ! has_launchctl; then
        yellow "launchctl is not available; skipping LaunchAgent coordination."
        return 0
    fi

    if is_loaded "$DASHBOARD_LABEL"; then
        if ! can_manage_service "$DASHBOARD_LABEL" "$DASHBOARD_PLIST"; then
            red "Dashboard service is loaded but its LaunchAgent plist is unavailable:"
            echo "  $DASHBOARD_PLIST"
            red "Rollback stopped before changing live files."
            return 1
        fi

        DASHBOARD_WAS_LOADED=1

        launchctl bootout \
            "$DOMAIN" \
            "$DASHBOARD_PLIST" \
            >/dev/null 2>&1

        if [[ $? -eq 0 ]]; then
            DASHBOARD_WAS_PAUSED=1
            SERVICES_PAUSED=1
            green "Dashboard service paused"
        else
            red "Could not pause dashboard service"
            return 1
        fi
    else
        yellow "Dashboard service was not loaded"
    fi

    if is_loaded "$NOW_PLAYING_LABEL"; then
        if ! can_manage_service "$NOW_PLAYING_LABEL" "$NOW_PLAYING_PLIST"; then
            red "Now-playing service is loaded but its LaunchAgent plist is unavailable:"
            echo "  $NOW_PLAYING_PLIST"
            red "Rollback stopped before changing live files."
            return 1
        fi

        NOW_PLAYING_WAS_LOADED=1

        launchctl bootout \
            "$DOMAIN" \
            "$NOW_PLAYING_PLIST" \
            >/dev/null 2>&1

        if [[ $? -eq 0 ]]; then
            NOW_PLAYING_WAS_PAUSED=1
            SERVICES_PAUSED=1
            green "Now-playing/listening-history job paused"
        else
            red "Could not pause now-playing/listening-history job"
            return 1
        fi
    else
        yellow "Now-playing/listening-history job was not loaded"
    fi

    sleep 1

    return 0
}

resume_services() {
    local failures=0

    if [[ $SERVICES_PAUSED -ne 1 ]]; then
        return 0
    fi

    heading "Restoring Service State"

    if [[ $DASHBOARD_WAS_PAUSED -eq 1 ]]; then
        launchctl bootstrap \
            "$DOMAIN" \
            "$DASHBOARD_PLIST" \
            >/dev/null 2>&1

        if [[ $? -eq 0 ]]; then
            green "Dashboard service loaded"
        else
            red "Could not reload dashboard service"
            failures=1
        fi
    fi

    if [[ $NOW_PLAYING_WAS_PAUSED -eq 1 ]]; then
        launchctl bootstrap \
            "$DOMAIN" \
            "$NOW_PLAYING_PLIST" \
            >/dev/null 2>&1

        if [[ $? -eq 0 ]]; then
            green "Now-playing/listening-history job loaded"
        else
            red "Could not reload now-playing/listening-history job"
            failures=1
        fi
    fi

    SERVICES_PAUSED=0
    return $failures
}

wait_for_dashboard() {
    local attempts=30
    local attempt=1
    local http_code=""

    if [[ $DASHBOARD_WAS_PAUSED -ne 1 ]]; then
        return 0
    fi

    heading "Waiting for Dashboard"

    if ! command -v curl >/dev/null 2>&1; then
        yellow "curl is unavailable; skipping dashboard HTTP readiness check."
        return 0
    fi

    while [[ $attempt -le $attempts ]]; do
        http_code="$(
            curl                 --silent                 --output /dev/null                 --write-out '%{http_code}'                 --max-time 2                 "$LOCAL_URL"                 2>/dev/null
        )"

        if [[ "$http_code" == "200" ]]; then
            green "Dashboard is ready (HTTP 200)"
            return 0
        fi

        sleep 1
        (( attempt++ ))
    done

    red "Dashboard did not become ready within 30 seconds."
    red "Run: ./bin/wefunk-dashboard-health"
    red "Run: wefunk errors"
    return 1
}

verify_snapshot() {
    SNAPSHOT="$1"

    heading "Verifying Target Snapshot"

    if [[ ! -d "$SNAPSHOT" ]]; then
        red "Snapshot directory does not exist:"
        echo "  $SNAPSHOT"
        return 1
    fi

    if [[ ! -f "$SNAPSHOT/manifest.txt" ]]; then
        red "Snapshot manifest is missing."
        return 1
    fi

    SNAPSHOT_DB="$SNAPSHOT/database/wefunk.db"
    CHECKSUM="$SNAPSHOT/database/wefunk.db.sha256"

    if [[ ! -f "$SNAPSHOT_DB" || ! -f "$CHECKSUM" ]]; then
        red "Snapshot database or checksum is missing."
        return 1
    fi

    (
        cd "$SNAPSHOT/database" || exit 1
        shasum -a 256 -c wefunk.db.sha256
    )

    if [[ $? -ne 0 ]]; then
        red "Snapshot checksum failed."
        return 1
    fi

    DB_CHECK="$(
        sqlite3 "$SNAPSHOT_DB" \
            'PRAGMA quick_check;' \
            2>&1
    )"

    if [[ "$DB_CHECK" != "ok" ]]; then
        red "Snapshot database integrity check failed."
        echo "$DB_CHECK"
        return 1
    fi

    green "Target recovery snapshot is valid"
}

restore_database() {
    SNAPSHOT="$1"
    SNAPSHOT_ID="$2"

    SNAPSHOT_DB="$SNAPSHOT/database/wefunk.db"
    DB_DIR="$(dirname "$DB")"

    RESTORE_TEMP="$DB_DIR/.wefunk-restore-$SNAPSHOT_ID-$$.db"
    ORIGINAL_DB="$DB_DIR/wefunk.db.before-restore-$(date '+%Y%m%d-%H%M%S')"

    heading "Restoring Database"

    heading "Checking SQLite Handles"

    if ! command -v lsof >/dev/null 2>&1; then
        red "lsof is required to verify that the live SQLite database is not writable."
        red "Rollback stopped before changing live files."
        return 1
    fi

    WRITABLE_HANDLE_FOUND=0
    READER_FOUND=0

    for SQLITE_FILE in \
        "$DB" \
        "$DB-wal" \
        "$DB-shm"
    do
        [[ -e "$SQLITE_FILE" ]] || continue

        HANDLE_OUTPUT="$(
            lsof -nP "$SQLITE_FILE" 2>/dev/null
        )"

        [[ -n "$HANDLE_OUTPUT" ]] || continue

        WRITABLE_OUTPUT="$(
            printf '%s\n' "$HANDLE_OUTPUT" \
                | awk 'NR == 1 || $4 ~ /[wu]$/'
        )"

        READ_ONLY_OUTPUT="$(
            printf '%s\n' "$HANDLE_OUTPUT" \
                | awk 'NR == 1 || $4 ~ /r$/'
        )"

        if printf '%s\n' "$HANDLE_OUTPUT" \
            | awk 'NR > 1 && $4 ~ /[wu]$/ { found=1 } END { exit !found }'
        then
            red "Writable SQLite handle detected:"
            echo
            printf '%s\n' "$WRITABLE_OUTPUT"
            echo
            WRITABLE_HANDLE_FOUND=1
        fi

        if printf '%s\n' "$HANDLE_OUTPUT" \
            | awk 'NR > 1 && $4 ~ /r$/ { found=1 } END { exit !found }'
        then
            if [[ $READER_FOUND -eq 0 ]]; then
                yellow "Read-only SQLite handles detected and allowed:"
                echo
                READER_FOUND=1
            fi

            printf '%s\n' "$READ_ONLY_OUTPUT"
            echo
        fi
    done

    if [[ $WRITABLE_HANDLE_FOUND -eq 1 ]]; then
        red "Database restore aborted."
        red "Close the writable process and try again."
        return 1
    fi

    if [[ $READER_FOUND -eq 0 ]]; then
        green "No open SQLite handles detected"
    else
        green "No writable SQLite handles detected"
    fi

    sqlite3 "$SNAPSHOT_DB" \
        ".backup '$RESTORE_TEMP'"

    if [[ $? -ne 0 ]]; then
        red "Could not create verified restore database."
        return 1
    fi

    TEMP_CHECK="$(
        sqlite3 "$RESTORE_TEMP" \
            'PRAGMA quick_check;' \
            2>&1
    )"

    if [[ "$TEMP_CHECK" != "ok" ]]; then
        red "Temporary restore database failed integrity check."
        echo "$TEMP_CHECK"
        return 1
    fi

    cp -p "$DB" "$ORIGINAL_DB"

    if [[ $? -ne 0 ]]; then
        red "Could not preserve current live database."
        return 1
    fi

    if [[ -f "$DB-wal" ]]; then
        mv \
            "$DB-wal" \
            "$ORIGINAL_DB-wal"
    fi

    if [[ -f "$DB-shm" ]]; then
        mv \
            "$DB-shm" \
            "$ORIGINAL_DB-shm"
    fi

    mv "$RESTORE_TEMP" "$DB"

    if [[ $? -ne 0 ]]; then
        red "Could not install restored database."
        return 1
    fi

    LIVE_CHECK="$(
        sqlite3 "$DB" \
            'PRAGMA quick_check;' \
            2>&1
    )"

    if [[ "$LIVE_CHECK" != "ok" ]]; then
        red "Restored live database failed integrity check."
        echo "$LIVE_CHECK"
        echo
        red "Services will remain paused."
        SERVICES_PAUSED=0
        return 1
    fi

    green "Database restored successfully"
    green "Restored database quick_check: ok"

    echo
    echo "Previous live database preserved as:"
    echo "  $ORIGINAL_DB"
}

restore_state() {
    SNAPSHOT="$1"

    heading "Restoring WEFUNK State"

    if [[ ! -d "$SNAPSHOT/state" ]]; then
        red "Snapshot state directory is missing."
        return 1
    fi

    mkdir -p "$STATE_DIR" || return 1

    rsync -a \
        "$SNAPSHOT/state/" \
        "$STATE_DIR/"

    if [[ $? -ne 0 ]]; then
        red "State restore failed."
        return 1
    fi

    green "WEFUNK state restored successfully"
}

restore_code() {
    SNAPSHOT="$1"

    heading "Restoring Project Code"

    if [[ ! -d "$SNAPSHOT/code" ]]; then
        red "Snapshot code directory is missing."
        return 1
    fi

    rsync -a \
        --exclude '.git/' \
        --exclude '.venv/' \
        --exclude 'backups/' \
        --exclude 'backup/' \
        --exclude 'site/' \
        --exclude 'site-next/' \
        --exclude 'site-backup-last-good/' \
        --exclude 'output-v2/' \
        --exclude 'logs/' \
        --exclude 'bin/wefunk-snapshot' \
        --exclude 'bin/wefunk-restore' \
        --exclude 'bin/wefunk-rollback' \
        "$SNAPSHOT/code/" \
        "$PROJECT/"

    if [[ $? -ne 0 ]]; then
        red "Code restore failed."
        return 1
    fi

    green "Project code restored successfully"

    echo
    yellow "Files added after the snapshot were not deleted."
    yellow "Recovery toolkit scripts were intentionally preserved."
}



# ==================================================================
# FULL ROLLBACK
# ==================================================================

check_database_handles() {
    local writable_found=0
    local reader_found=0
    local sqlite_file=""
    local handle_output=""
    local writable_output=""
    local read_only_output=""

    heading "Checking SQLite Handles"

    for sqlite_file in \
        "$DB" \
        "$DB-wal" \
        "$DB-shm"
    do
        [[ -e "$sqlite_file" ]] || continue

        handle_output="$(
            lsof -nP "$sqlite_file" 2>/dev/null
        )"

        [[ -n "$handle_output" ]] || continue

        writable_output="$(
            printf '%s\n' "$handle_output" \
                | awk 'NR == 1 || $4 ~ /[wu]$/'
        )"

        read_only_output="$(
            printf '%s\n' "$handle_output" \
                | awk 'NR == 1 || $4 ~ /r$/'
        )"

        if printf '%s\n' "$handle_output" \
            | awk 'NR > 1 && $4 ~ /[wu]$/ { found=1 } END { exit !found }'
        then
            red "Writable SQLite handle detected:"
            echo
            printf '%s\n' "$writable_output"
            echo
            writable_found=1
        fi

        if printf '%s\n' "$handle_output" \
            | awk 'NR > 1 && $4 ~ /r$/ { found=1 } END { exit !found }'
        then
            if [[ $reader_found -eq 0 ]]; then
                yellow "Read-only SQLite handles detected and allowed:"
                echo
                reader_found=1
            fi

            printf '%s\n' "$read_only_output"
            echo
        fi
    done

    if [[ $writable_found -eq 1 ]]; then
        red "Rollback cannot safely begin."
        red "Close the writable process and try again."
        return 1
    fi

    if [[ $reader_found -eq 0 ]]; then
        green "No open SQLite handles detected"
    else
        green "No writable SQLite handles detected"
    fi

    return 0
}

ROLLBACK_MUTATION_STARTED=0

rollback_exit_handler() {
    local status=$?

    if [[ $status -eq 0 ]]; then
        return 0
    fi

    echo

    if [[ $ROLLBACK_MUTATION_STARTED -eq 1 ]]; then
        # Fail closed. Do not restart services after a partial rollback.
        SERVICES_PAUSED=0

        red "Rollback did not complete successfully."
        red "Live changes had already begun."
        red "WEFUNK services have been left paused for safety."

        echo
        yellow "Use the automatic pre-rollback snapshot to recover."
        yellow "Inspect the error before restarting services."
    else
        # No live files changed yet; restore any service that was
        # temporarily paused during preflight.
        resume_services
    fi

    return $status
}

DRY_RUN=0

if [[ "${1:-}" == "--help" || "${1:-}" == "-h" ]]; then
    usage
    exit 0
fi

if [[ "${1:-}" == "--dry-run" ]]; then
    DRY_RUN=1
    shift
fi

if [[ $# -lt 1 ]]; then
    usage
    exit 1
fi

SNAPSHOT_ID="$1"

case "$SNAPSHOT_ID" in
    *[!0-9-]*|'')
        red "Invalid snapshot ID:"
        echo "  $SNAPSHOT_ID"
        exit 1
        ;;
esac

SNAPSHOT="$RECOVERY_ROOT/$SNAPSHOT_ID"

heading "WEFUNK Full Rollback"

echo "Snapshot:"
echo "  $SNAPSHOT_ID"
echo
echo "Components:"
echo "  code"
echo "  database"
echo "  state"
echo

verify_snapshot "$SNAPSHOT" || exit 1

if [[ ! -d "$SNAPSHOT/code" ]]; then
    red "Snapshot code directory is missing."
    exit 1
fi

if [[ ! -d "$SNAPSHOT/state" ]]; then
    red "Snapshot state directory is missing."
    exit 1
fi

if [[ $DRY_RUN -eq 1 ]]; then
    heading "Dry Run Rollback Plan"

    green "No live files will be changed"
    green "No recovery snapshot will be created"
    green "No services will be stopped"

    echo
    echo "Target snapshot:"
    echo "  $SNAPSHOT_ID"

    echo
    echo "Service coordination:"

    if ! has_launchctl; then
        echo "  - launchctl unavailable; no LaunchAgents would be managed"
    else
        if is_loaded "$DASHBOARD_LABEL"; then
            if can_manage_service "$DASHBOARD_LABEL" "$DASHBOARD_PLIST"; then
                echo "  - $DASHBOARD_LABEL (would be paused)"
            else
                echo "  - $DASHBOARD_LABEL (loaded, but plist unavailable — rollback would stop)"
            fi
        else
            echo "  - $DASHBOARD_LABEL (not currently loaded)"
        fi

        if is_loaded "$NOW_PLAYING_LABEL"; then
            if can_manage_service "$NOW_PLAYING_LABEL" "$NOW_PLAYING_PLIST"; then
                echo "  - $NOW_PLAYING_LABEL (would be paused)"
            else
                echo "  - $NOW_PLAYING_LABEL (loaded, but plist unavailable — rollback would stop)"
            fi
        else
            echo "  - $NOW_PLAYING_LABEL (not currently loaded)"
        fi
    fi

    echo
    echo "Rollback sequence:"
    echo "  1. Create one automatic pre-rollback snapshot"
    echo "  2. Pause WEFUNK services"
    echo "  3. Confirm no writable SQLite handles remain"
    echo "  4. Restore project code"
    echo "  5. Preserve current live database"
    echo "  6. Restore snapshot database"
    echo "  7. Run SQLite quick_check"
    echo "  8. Restore snapshot state"
    echo "  9. Restore prior service state"
    echo " 10. Wait for dashboard HTTP 200"

    echo
    yellow "Files added after the snapshot will not be deleted."
    yellow "Recovery toolkit scripts will be preserved."

    heading "Dry Run Complete"
    green "Full rollback plan validated successfully"

    exit 0
fi

heading "Confirmation"

yellow "This will roll back live WEFUNK code, database, and state."
yellow "An automatic safety snapshot will be created first."

echo
echo "Rollback target:"
echo "  $SNAPSHOT_ID"
echo

printf "Type ROLLBACK to continue: "
read -r CONFIRMATION

if [[ "$CONFIRMATION" != "ROLLBACK" ]]; then
    yellow "Rollback cancelled."
    exit 0
fi

heading "Creating Automatic Pre-Rollback Snapshot"

if [[ ! -x "$SNAPSHOT_SCRIPT" ]]; then
    red "Snapshot tool is missing:"
    echo "  $SNAPSHOT_SCRIPT"
    exit 1
fi

"$SNAPSHOT_SCRIPT" \
    "Automatic pre-rollback snapshot before $SNAPSHOT_ID"

if [[ $? -ne 0 ]]; then
    red "Pre-rollback snapshot failed."
    red "No live files were changed."
    exit 1
fi

# EXIT handler restores service state only while no mutation has begun.
# Once any live rollback begins, failures are deliberately fail-closed.
trap rollback_exit_handler EXIT
trap 'exit 130' INT
trap 'exit 143' TERM

pause_services || exit 1

# Database handle safety must pass BEFORE changing any live component.
check_database_handles || exit 1

ROLLBACK_MUTATION_STARTED=1

heading "Rollback Phase 1 of 3 — Code"

restore_code \
    "$SNAPSHOT" \
    || exit 1

heading "Rollback Phase 2 of 3 — Database"

restore_database \
    "$SNAPSHOT" \
    "$SNAPSHOT_ID" \
    || exit 1

heading "Rollback Phase 3 of 3 — State"

restore_state \
    "$SNAPSHOT" \
    || exit 1

# All three components completed successfully.
ROLLBACK_MUTATION_STARTED=0

if ! resume_services; then
    trap - EXIT INT TERM
    red "Rollback completed, but one or more WEFUNK services could not be restarted."
    red "Run: ./bin/wefunk-dashboard-health"
    exit 1
fi

if ! wait_for_dashboard; then
    trap - EXIT INT TERM
    red "Rollback completed, but dashboard readiness verification failed."
    exit 1
fi

trap - EXIT INT TERM

heading "Rollback Complete"

green "WEFUNK full rollback completed successfully"

echo
echo "Restored from:"
echo "  $SNAPSHOT_ID"

echo
echo "Recommended checks:"
echo "  ./bin/wefunk-dashboard-health"
